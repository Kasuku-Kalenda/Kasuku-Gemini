# ─── Kasuku — Variables d'environnement PRODUCTION ───────────────────────────
#
# 1. Copier ce fichier : cp .env.prod.example .env.prod
# 2. Remplir TOUTES les valeurs marquées ⚠️
# 3. Ne JAMAIS committer .env.prod sur git
#
# Générer des secrets forts :
#   openssl rand -base64 48

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=kasuku
POSTGRES_PASSWORD=⚠️_CHANGER_MOT_DE_PASSE_FORT        # ex: openssl rand -base64 32
POSTGRES_DB=kasuku_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=⚠️_CHANGER_MOT_DE_PASSE_REDIS           # ex: openssl rand -base64 32
REDIS_URL=redis://:⚠️_REDIS_PASSWORD@redis:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=⚠️_CHANGER_SECRET_JWT_TRES_LONG             # ex: openssl rand -base64 64
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ── MinIO (stockage fichiers) ─────────────────────────────────────────────────
MINIO_ROOT_USER=kasuku_minio
MINIO_ROOT_PASSWORD=⚠️_CHANGER_MOT_DE_PASSE_MINIO      # ex: openssl rand -base64 32
MINIO_BUCKET=kasuku-media

# ── Admin initial ─────────────────────────────────────────────────────────────
INITIAL_ADMIN_EMAIL=⚠️_TON_EMAIL_ADMIN
INITIAL_ADMIN_PASSWORD=⚠️_MOT_DE_PASSE_ADMIN_FORT
INITIAL_ADMIN_NAME=Admin Kasuku

# ── URLs (ne pas modifier si domaine = kasuku.afrikia.org) ────────────────────
VITE_API_URL=https://kasuku.afrikia.org/api/v1
MINIO_PUBLIC_URL=https://kasuku.afrikia.org/storage
CORS_ORIGINS=https://kasuku.afrikia.org
