# ─── Kasuku — Variables d'environnement ──────────────────────────────────────
# Copier ce fichier en .env et remplir les valeurs avant de lancer Docker.
# Ne jamais committer .env dans git.

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_INITDB_ROOT_USERNAME=kasuku
MONGO_INITDB_ROOT_PASSWORD=changeme_strong_password
MONGO_INITDB_DATABASE=kasuku_db
MONGODB_URI=mongodb://kasuku:changeme_strong_password@mongo:27017/kasuku_db?authSource=admin

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── MinIO (stockage objets) ──────────────────────────────────────────────────
MINIO_ROOT_USER=kasuku_minio
MINIO_ROOT_PASSWORD=changeme_minio_password
MINIO_BUCKET=kasuku-media
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
# URL publique pour les assets (ex: https://cdn.kasuku.app)
MINIO_PUBLIC_URL=http://localhost/storage

# ─── API ──────────────────────────────────────────────────────────────────────
API_PORT=4000
# Générer avec: openssl rand -base64 64
JWT_SECRET=changeme_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Admin initial créé au premier démarrage
INITIAL_ADMIN_EMAIL=admin@kasuku.app
INITIAL_ADMIN_PASSWORD=changeme_admin_password
INITIAL_ADMIN_NAME=Admin Kasuku

# CORS — origines autorisées (séparées par virgule)
CORS_ORIGINS=http://localhost,http://localhost:3000,https://kasuku.app

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
VITE_API_URL=http://localhost/api/v1

# ─── Environnement ────────────────────────────────────────────────────────────
NODE_ENV=development
